{
  "name": "@moubarat/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/seed/demo.ts",
    "reviewer:create": "tsx --env-file-if-exists=.env src/scripts/create-reviewer-account.ts",
    "crm:create-account": "tsx --env-file-if-exists=.env src/scripts/create-crm-account.ts",
    "superadmin:create": "tsx --env-file-if-exists=.env src/scripts/create-superadmin.ts",
    "superadmin:reset-password": "tsx --env-file-if-exists=.env src/scripts/reset-superadmin-password.ts",
    "demo:seed": "tsx --env-file-if-exists=.env src/scripts/seed-demo-venue.ts",
    "demo:catalogue": "tsx --env-file-if-exists=.env src/scripts/seed-demo-catalogue.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@moubarat/core": "workspace:*",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.2",
    "kysely": "^0.28.8",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "@types/pg": "^8.16.0",
    "tsx": "^4.20.7",
    "typescript": "5.5",
    "vitest": "^2.1.9"
  }
}
